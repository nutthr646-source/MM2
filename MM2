-- Container
local Container = Instance.new("ScrollingFrame", MainFrame)
Container.Size = UDim2.new(1, -20, 1, -55)
Container.Position = UDim2.new(0, 10, 0, 45)
Container.BackgroundTransparency = 1
Container.CanvasSize = UDim2.new(0, 0, 0, 315)
Container.ScrollBarThickness = 4
Instance.new("UIListLayout", Container).Padding = UDim.new(0, 10)

-- Helper Button Creator
local function createButton(text)
	local btn = Instance.new("TextButton", Container)
	btn.Size = UDim2.new(1, 0, 0, 45)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Text = text .. ": OFF"
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	return btn
end

local InfJumpBtn = createButton("1. กระโดดไม่จำกัด")
local ESPBtn = createButton("2. ดูบทบาทคน")
local AutoGunBtn = createButton("3. เก็บปืนอัตโนมัติ")
local InvisBtn = createButton("4. ล่องหน")
local SpeedBtn = createButton("5. วิ่งเร็ว 40")

-- Logic Variables
local toggles = {inf = false, esp = false, autoGun = false, invis = false, speed = false}
local espObjects = {}

-- Features
InfJumpBtn.MouseButton1Click:Connect(function()
	toggles.inf = not toggles.inf
	InfJumpBtn.Text = "1. กระโดดไม่จำกัด: " .. (toggles.inf and "ON" or "OFF")
end)

UserInputService.JumpRequest:Connect(function()
	if toggles.inf then LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.Jumping) end
end)

ESPBtn.MouseButton1Click:Connect(function()
	toggles.esp = not toggles.esp
	ESPBtn.Text = "2. ดูบทบาทคน: " .. (toggles.esp and "ON" or "OFF")
	if not toggles.esp then for _,v in pairs(espObjects) do v:Destroy() end espObjects = {} end
end)

RunService.RenderStepped:Connect(function()
	if toggles.esp then
		for _,v in pairs(espObjects) do v:Destroy() end espObjects = {}
		for _,p in pairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local bill = Instance.new("BillboardGui", p.Character.HumanoidRootPart)
				bill.Size = UDim2.new(0, 100, 0, 40); bill.AlwaysOnTop = true
				local lbl = Instance.new("TextLabel", bill)
				lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1
				lbl.Text = p.Name; lbl.TextColor3 = Color3.new(1, 1, 1)
				table.insert(espObjects, bill)
			end
		end
	end
	if toggles.autoGun then
		for _,obj in pairs(workspace:GetChildren()) do
			if (obj.Name == "GunDrop" or obj.Name == "DroppedGun") and LocalPlayer.Character then
				LocalPlayer.Character.HumanoidRootPart.CFrame = obj.CFrame
			end
		end
	end
	if toggles.speed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
		LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 40
	end
end)

InvisBtn.MouseButton1Click:Connect(function()
	toggles.invis = not toggles.invis
	InvisBtn.Text = "4. ล่องหน: " .. (toggles.invis and "ON" or "OFF")
	for _,part in pairs(LocalPlayer.Character:GetDescendants()) do if part:IsA("BasePart") then part.Transparency = toggles.invis and 1 or 0 end end
end)

SpeedBtn.MouseButton1Click:Connect(function()
	toggles.speed = not toggles.speed
	SpeedBtn.Text = "5. วิ่งเร็ว 40: " .. (toggles.speed and "ON" or "OFF")
	if not toggles.speed and LocalPlayer.Character then LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16 end
end)

-- Rainbow & Drag
task.spawn(function()
	local h = 0
	while true do h = (h + 0.005) % 1 UIStroke.Color = Color3.fromHSV(h, 1, 1) task.wait(0.03) end
end)

local dragging, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true; dragStart = input.Position; startPos = MainFrame.Position
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)

CloseButton.MouseButton1Click:Connect(function() MainFrame.Visible = false end)
ToggleButton.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)
